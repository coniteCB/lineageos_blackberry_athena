Description: Do not fail the build when a host tool is invoked from PATH.
Soong's path_interposer aborts the build for any host binary not on its allowlist.
On this build host several such tools are unavoidable, so downgrade the hard
failure to a no-op: the fmt.Errorf call is kept (it still formats the message for
the log path above) but its result is no longer returned as an error exit.

Build-host workaround only — does not affect anything shipped on the device.

File: build/soong/cmd/path_interposer/main.go
Apply from: build/soong/
  cd build/soong && patch -p1 < build-soong-path-interposer-suppress-error.patch

diff --git a/cmd/path_interposer/main.go b/cmd/path_interposer/main.go
--- a/cmd/path_interposer/main.go
+++ b/cmd/path_interposer/main.go
@@ -140,7 +140,7 @@ func Main(stdout, stderr io.Writer, interposer string, args []string, opts mainO
 			defer func() { <-waitForLog }()
 		}
 		if config.Error {
-			return 1, fmt.Errorf("%q is not allowed to be used. See https://android.googlesource.com/platform/build/+/main/Changes.md#PATH_Tools for more information.", base)
+			fmt.Errorf("%q is not allowed to be used. See https://android.googlesource.com/platform/build/+/main/Changes.md#PATH_Tools for more information.", base)
 		}
 	}
 

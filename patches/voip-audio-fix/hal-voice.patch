From: krab-ubica
Subject: msm8998-audio: handle VOIP call usecase in voice device updater

voice_update_devices_for_all_voice_usecases() only looked at
VOICE_CALL usecases, so when a VoIP / IMS call was active the HAL
never re-routed its stream on device changes. Include VOIP_CALL too.

File: hardware/qcom-caf/sdm660/audio/hal/voice.c
Apply from: hardware/qcom-caf/sdm660/audio/
  cd hardware/qcom-caf/sdm660/audio && patch -p1 < hal-voice.patch

diff --git a/hal/voice.c b/hal/voice.c
--- a/hal/voice.c
+++ b/hal/voice.c
@@ -863,7 +863,7 @@ void voice_update_devices_for_all_voice_usecases(struct audio_device *adev)

     list_for_each(node, &adev->usecase_list) {
         usecase = node_to_item(node, struct audio_usecase, list);
-        if (usecase->type == VOICE_CALL) {
+        if (usecase->type == VOICE_CALL || usecase->type == VOIP_CALL) {
             ALOGV("%s: updating device for usecase:%s", __func__,
                   use_case_table[usecase->id]);
             usecase->stream.out = adev->current_call_output;
